// Target persistence model. Not wired yet — the app runs on the MockRepository
// (src/lib/data/repository.ts). Install `prisma` + `@prisma/client` to activate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RidingStyle {
  PARK
  ALL_MOUNTAIN
  FREERIDE
}

enum BoardProfile {
  CAMBER
  ROCKER
  FLAT
  HYBRID_CAMBER
  HYBRID_ROCKER
  DIRECTIONAL_CAMBER
}

enum BoardShape {
  TRUE_TWIN
  DIRECTIONAL_TWIN
  DIRECTIONAL
  TAPERED
}

enum WaistClass {
  REGULAR
  MID_WIDE
  WIDE
}

enum DealTier {
  EXTREMELY_GOOD
  VERY_GOOD
  GOOD
  NORMAL
  BAD
}

enum AmbassadorConfidence {
  CONFIRMED
  LIKELY
}

model Retailer {
  id               String         @id
  name             String
  homepage         String
  country          String         @db.Char(2)
  currency         String         @db.Char(3)
  pricesIncludeVat Boolean
  shippingRules    ShippingRule[]
  listings         Listing[]
}

model ShippingRule {
  id           String   @id @default(cuid())
  retailer     Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  retailerId   String
  destinations String[] // ISO-2 codes, "*" = rest of world
  cost         Decimal  @db.Decimal(10, 2)
  freeAbove    Decimal? @db.Decimal(10, 2)
  etaMinDays   Int?
  etaMaxDays   Int?
}

model BoardModel {
  id            String          @id @default(cuid())
  brand         String
  model         String
  season        String
  profile       BoardProfile
  shape         BoardShape
  flex          Int
  styles        RidingStyle[]
  msrpAmount    Decimal         @db.Decimal(10, 2)
  msrpCurrency  String          @db.Char(3)
  images        String[]
  reviewAvg     Float?
  reviewCount   Int?
  listings      Listing[]
  ambassadors   BoardAmbassador[]
  reviewSources ReviewSource[]

  @@unique([brand, model, season])
}

model ProRider {
  id          String            @id @default(cuid())
  name        String            @unique
  disciplines RidingStyle[]
  boards      BoardAmbassador[]
}

model BoardAmbassador {
  board      BoardModel           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId    String
  rider      ProRider             @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId    String
  confidence AmbassadorConfidence
  sourceUrl  String?

  @@id([boardId, riderId])
}

model ReviewSource {
  id      String     @id @default(cuid())
  board   BoardModel @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId String
  name    String
  url     String?
  average Float
  count   Int
}

model Listing {
  id            String        @id @default(cuid())
  board         BoardModel    @relation(fields: [boardId], references: [id])
  boardId       String
  retailer      Retailer      @relation(fields: [retailerId], references: [id])
  retailerId    String
  url           String        @unique
  priceAmount   Decimal       @db.Decimal(10, 2)
  priceCurrency String        @db.Char(3)
  lastScrapedAt DateTime
  sizes         ListingSize[]
  history       PricePoint[]
  // Denormalized grade, recomputed after each scrape for fast tier queries.
  tier          DealTier?
  score         Int?

  @@index([tier, score])
}

model ListingSize {
  id           String     @id @default(cuid())
  listing      Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId    String
  lengthCm     Int
  waist        WaistClass
  waistWidthMm Int?
  label        String
  inStock      Boolean

  @@index([lengthCm, waist])
}

model PricePoint {
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  date      DateTime @db.Date
  price     Decimal  @db.Decimal(10, 2)
  inStock   Boolean

  @@id([listingId, date])
}
