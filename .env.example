# Database
#   unset                       → demo mode (built-in mock catalog)
#   pglite:./data/pglite        → embedded Postgres in a local folder (no install)
#   postgres://user:pass@host/db → hosted Postgres (Neon, Supabase, RDS, …)
DATABASE_URL=pglite:./data/pglite

# Scraper politeness: min delay between requests to the same host (ms)
SCRAPER_MIN_DELAY_MS=2500
